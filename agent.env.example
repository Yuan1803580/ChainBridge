# External Agent bundle environment (docker-compose.agent.yml)
# Copy to agent.env and fill the values. Lines left blank are auto-generated
# by the signer image entrypoint (token / storage key) — safe to leave empty
# for a quick start, but pin them for reproducible restarts (see doc).

# --- Signer (leave blank to auto-generate) ---
# SIDECAR_PROVISIONING_TOKEN=
# SIDECAR_STORAGE_KEY=
# Shared HMAC for worker-intent signatures (optional for testnet demo).
WORKER_INTENT_HMAC_SECRET=

# --- Runner ---
# Base URL of the platform API the runner reports to / is dispatched from.
PLATFORM_API_URL=https://<YOUR_SERVER_IP>/api
# Token the platform uses to drive the managed runner control plane.
AGENT_RUNNER_API_TOKEN=
RUNNER_CONTROL_HMAC_SECRET=
# LLM key for provider capability execution. NEVER on the platform side.
DEEPSEEK_API_KEY=

# --- Network ---
# Public port the platform uses to reach THIS machine's runner (dispatch).
RUNNER_PORT=8010

# --- Optional image overrides (defaults point at the published GHCR images) ---
# SIDECAR_IMAGE=ghcr.io/yuan1803580/agent-signer:latest
# RUNNER_IMAGE=ghcr.io/yuan1803580/agent-runner:latest

{
  "name": "agent-crosschain-shop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "local:v1": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/run-full-local-v1.ps1",
    "local:v1:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/start-platform-v1.ps1",
    "local:v1:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/stop-platform-v1.ps1",
    "local:v1:accept": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/run-local-v1.ps1",
    "local:v1:protocol-accept": "node scripts/local-protocol-worker-acceptance.ts",
    "local:v1:contracts-accept": "node scripts/local-v1-acceptance.ts",
    "local:v1:api-demo": "node scripts/local-v1-api-demo.ts",
    "local:v1:verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/verify-local-v1.ps1",
    "testnet:managed:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/testnet/start-managed-testnet.ps1",
    "testnet:managed:easy-start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/testnet/start-managed-testnet-easy.ps1",
    "testnet:managed:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/testnet/status-managed-testnet.ps1",
    "testnet:managed:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/testnet/stop-managed-testnet.ps1",
    "testnet:managed:verify-config": "node scripts/testnet/verify-managed-testnet-config.ts",
    "testnet:managed:create-route": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/testnet/create-managed-route.ps1",
    "platform:dev": "pnpm --dir apps/web dev",
    "platform:build": "pnpm --dir apps/web build",
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "test:web": "pnpm --dir apps/web test",
    "test:e2e": "pnpm --dir apps/web test:e2e",
    "visual:workflow-funding": "node scripts/workflow-funding-visual-qa.mjs",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test nodejs",
    "contracts:demo": "hardhat run scripts/demo-crosschain-local.ts",
    "contracts:deploy:wallet-local": "hardhat run --network localhost --no-compile scripts/deploy-wallet-local.ts",
    "contracts:deploy:real-receiver": "hardhat run --network destinationTestnet scripts/deploy-real-ccip-receiver.ts",
    "contracts:deploy:real-escrow": "hardhat run --network sourceTestnet scripts/deploy-real-marketplace-escrow.ts",
    "contracts:deploy:real-sender": "hardhat run --network sourceTestnet scripts/deploy-real-ccip-sender.ts",
    "contracts:configure:real-receiver": "hardhat run --network destinationTestnet scripts/configure-real-ccip-receiver.ts",
    "contracts:configure:real-escrow": "hardhat run --network sourceTestnet scripts/configure-real-marketplace-escrow.ts",
    "contracts:test:direct-ccip-send": "hardhat run --network sourceTestnet scripts/send-real-ccip-settlement.ts",
    "contracts:deploy:mock-stc": "hardhat run --network destinationTestnet scripts/deploy-mock-stc.ts",
    "contracts:seed:stc-pool": "hardhat run --network destinationTestnet scripts/seed-uniswap-v3-stc-pool.ts",
    "contracts:verify:stc-pool": "hardhat run --network destinationTestnet scripts/verify-stc-liquidity.ts",
    "testnet:verify-acceptance": "node scripts/verify-testnet-acceptance.ts",
    "wallet:fund-via-0x": "hardhat run --network sourceTestnet scripts/fund-order-via-0x.ts",
    "wallet:swap-payout": "hardhat run --network destinationTestnet scripts/swap-payout-to-stc.ts",
    "worker:start": "node services/chain-worker/src/index.ts",
    "worker:protocol": "node services/chain-worker/src/protocol-index.ts",
    "worker:dead-letters": "node services/chain-worker/src/dead-letter.ts",
    "worker:test": "node --test services/chain-worker/test/*.test.ts",
    "worker:typecheck": "tsc -p services/chain-worker/tsconfig.json"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.20.1",
    "dotenv": "^17.4.2",
    "hardhat": "^3.11.1",
    "typescript": "^5.9.3",
    "viem": "^2.55.8"
  },
  "dependencies": {
    "@chainlink/contracts": "^1.5.0",
    "@chainlink/contracts-ccip": "^2.0.0",
    "@chainlink/local": "^0.2.9",
    "@openzeppelin/contracts": "^5.6.1"
  },
  "type": "module"
}

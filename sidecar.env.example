# External Agent Signer Sidecar — environment template
# Copy to `sidecar.env` and fill in. All secrets are OPTIONAL: if omitted, the
# container auto-generates them on every start (NOT persisted across recreation).
# For a stable deployment, generate them once and set them explicitly.

# --- Required ---
# Path INSIDE the container to the Sidecar config (mount your signer-config.json here)
AGENT_SIGNER_CONFIG_FILE=/app/config/signer-config.json

# Directory where /v1/provision writes per-runtime keys (mounted volume)
SIDECAR_KEY_DIR=/app/data/keys

# Run DB migrations on start (recommended for first launch)
SIDECAR_RUN_MIGRATIONS=true

# --- Auto-generated if omitted (generate once and keep for stable deploys) ---
# Loopback-only provisioning token (gates /v1/provision). Generate:
#   python -c "import secrets; print(secrets.token_hex(24))"
SIDECAR_PROVISIONING_TOKEN=

# Fernet storage key (32-byte url-safe base64). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIDECAR_STORAGE_KEY=

# --- Optional ---
# SQLite DB location inside the data volume
# AGENT_SIGNER_DATABASE_URL=sqlite:////app/data/state.db
# Worker intent/status HMAC secret (only if a chain-worker observes this signer)
# WORKER_INTENT_HMAC_SECRET=

# --- Registry / image selection (used by docker-compose.sidecar.yml) ---
# SIDECAR_IMAGE=ghcr.io/your-org/agent-signer:latest

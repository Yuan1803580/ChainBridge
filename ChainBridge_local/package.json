{
  "name": "agent-crosschain-shop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "local:experiment": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/run-full-local-experiment.ps1",
    "local:experiment:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/start-local-experiment.ps1",
    "local:experiment:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/stop-local-experiment.ps1",
    "local:mock-agents:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/mock-agent-runner-control.ps1 -Action status",
    "local:mock-agent-c:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/mock-agent-runner-control.ps1 -Action stop -Agent C",
    "local:mock-agent-c:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/mock-agent-runner-control.ps1 -Action start -Agent C",
    "local:mock-agent-c:restart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/mock-agent-runner-control.ps1 -Action restart -Agent C",
    "test:mock-agent-isolation": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/test-mock-agent-isolation.ps1",
    "local:coordinator:onboard": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/onboard-coordinator-agent.ps1",
    "local:executors:onboard": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/onboard-local-executor-agents.ps1",
    "local:agents:connect": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/ensure-local-agents.ps1",
    "local:stack:check": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/check-local-stack.ps1",
    "local:kimi:onboard": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/onboard-kimi-agent.ps1",
    "local:kimi:registered:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/start-registered-kimi-runner.ps1",
    "local:kimi:fund-gas": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/fund-kimi-gas.ps1",
    "local:kimi:e2e": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/run-kimi-e2e.ps1",
    "local:v1": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/run-full-local-v1.ps1",
    "local:v1:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/start-platform-v1.ps1",
    "local:v1:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/stop-platform-v1.ps1",
    "local:v1:accept": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/run-local-v1.ps1",
    "local:v1:protocol-accept": "node scripts/local-protocol-worker-acceptance.ts",
    "local:v1:contracts-accept": "node scripts/local-v1-acceptance.ts",
    "local:v1:api-demo": "node scripts/local-v1-api-demo.ts",
    "local:v1:verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local/verify-local-v1.ps1",
    "platform:dev": "pnpm --dir apps/web dev",
    "platform:build": "pnpm --dir apps/web build",
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "requester:install": "npm --prefix tools/local-requester-client ci",
    "requester:test": "npm --prefix tools/local-requester-client test",
    "requester": "npm --prefix tools/local-requester-client run requester --",
    "requester:serve": "npm --prefix tools/local-requester-client run serve",
    "test:web": "pnpm --dir apps/web test",
    "test:e2e": "pnpm --dir apps/web test:e2e",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test nodejs",
    "contracts:demo": "hardhat run scripts/demo-crosschain-local.ts",
    "contracts:deploy:wallet-local": "hardhat run --network localhost --no-compile scripts/deploy-wallet-local.ts",
    "contracts:deploy:real-receiver": "hardhat run --network destinationTestnet scripts/deploy-real-ccip-receiver.ts",
    "contracts:deploy:real-escrow": "hardhat run --network sourceTestnet scripts/deploy-real-marketplace-escrow.ts",
    "contracts:deploy:real-sender": "hardhat run --network sourceTestnet scripts/deploy-real-ccip-sender.ts",
    "contracts:configure:real-receiver": "hardhat run --network destinationTestnet scripts/configure-real-ccip-receiver.ts",
    "contracts:configure:real-escrow": "hardhat run --network sourceTestnet scripts/configure-real-marketplace-escrow.ts",
    "contracts:test:direct-ccip-send": "hardhat run --network sourceTestnet scripts/send-real-ccip-settlement.ts",
    "contracts:deploy:mock-stc": "hardhat run --network destinationTestnet scripts/deploy-mock-stc.ts",
    "contracts:seed:stc-pool": "hardhat run --network destinationTestnet scripts/seed-uniswap-v3-stc-pool.ts",
    "contracts:verify:stc-pool": "hardhat run --network destinationTestnet scripts/verify-stc-liquidity.ts",
    "testnet:verify-acceptance": "node scripts/verify-testnet-acceptance.ts",
    "wallet:fund-via-0x": "hardhat run --network sourceTestnet scripts/fund-order-via-0x.ts",
    "wallet:swap-payout": "hardhat run --network destinationTestnet scripts/swap-payout-to-stc.ts",
    "worker:start": "node services/chain-worker/src/index.ts",
    "experiment:v2:relay": "node services/chain-worker/src/experiment-v2-index.ts",
    "experiment:v2:deploy": "node scripts/experiment-v2-deploy.ts",
    "experiment:v2:add-chain-d": "node scripts/experiment-v2-add-chain-d.ts",
    "experiment:v2:accept": "node scripts/experiment-v2-acceptance.ts",
    "experiment:v2:besu:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/experiment-v2/start-besu.ps1",
    "experiment:v2:besu:deploy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/experiment-v2/deploy-besu.ps1",
    "experiment:v2:besu:add-chain-d": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/experiment-v2/start-besu-chain-d.ps1",
    "experiment:v2:besu:activate-chain-d": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/experiment-v2/add-chain-d-besu.ps1",
    "experiment:v2:besu:accept": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/experiment-v2/accept-besu.ps1",
    "experiment:v2:besu:run": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/experiment-v2/run-besu.ps1",
    "experiment:v2:besu:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/experiment-v2/stop-besu.ps1",
    "experiment:v2:hardhat:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/experiment-v2/start-hardhat.ps1",
    "experiment:v2:hardhat:run": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/experiment-v2/run-hardhat.ps1",
    "experiment:v2:hardhat:add-chain-d": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/experiment-v2/start-hardhat-chain-d.ps1",
    "experiment:v2:hardhat:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/experiment-v2/stop-hardhat.ps1",
    "experiment:real-agents": "python experiments/real_agents/run_real_agent_experiments.py",
    "experiment:summary": "python experiments/summarize_experiments.py",
    "experiment:algorithm4:platform:smoke": "python experiments/algorithm4_platform/run_algorithm4_platform.py --rounds 1 --variants NFRDA",
    "experiment:algorithm4:platform": "python experiments/algorithm4_platform/run_algorithm4_platform.py --rounds 30",
    "worker:protocol": "node services/chain-worker/src/protocol-index.ts",
    "worker:dead-letters": "node services/chain-worker/src/dead-letter.ts",
    "worker:test": "node --test services/chain-worker/test/*.test.ts",
    "worker:typecheck": "tsc -p services/chain-worker/tsconfig.json",
    "security:offline": "python experiments/security/run_security_experiments.py --mode offline"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.20.1",
    "dotenv": "^17.4.2",
    "hardhat": "^3.11.1",
    "typescript": "^5.9.3",
    "viem": "^2.55.8"
  },
  "dependencies": {
    "@chainlink/contracts": "^1.5.0",
    "@chainlink/contracts-ccip": "^2.0.0",
    "@chainlink/local": "^0.2.9",
    "@openzeppelin/contracts": "^5.6.1"
  },
  "type": "module"
}

# API
APP_ENV=development
APP_SECRET=replace-with-a-random-development-secret
DATABASE_URL=sqlite:///./data/agent_market.db
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# mock completes locally; external_ccip waits for authenticated chain-event reconciliation.
SETTLEMENT_MODE=mock

# Risk review V2. Local development uses post-result mock randomness. Production
# fails closed unless REVIEW_RANDOMNESS_MODE=VRF and an authenticated VRF listener
# submits the Chainlink request/fulfillment proof through the listener endpoint.
REVIEW_RANDOMNESS_MODE=MOCK
AUTO_MEDIUM_SAMPLING_BPS=0
AUTO_HIGH_CHALLENGE_SECONDS=3600
ARBITRATION_THRESHOLD=2
REVIEW_SIGNATURE_MAX_TTL_SECONDS=900
# Normally registered by the Protocol Worker after deployment. Set this only
# when the ReviewManagerV2 address is managed outside the local launcher.
REVIEW_MANAGER_ADDRESS=

# 0x Swap API. External settlement mode fails closed when token/target
# configuration is missing; it never falls back to the mock fixed rate.
ZERO_EX_API_URL=https://api.0x.org
ZERO_EX_API_KEY=
ZERO_EX_ALLOWED_TARGETS=
# Official 0x AllowanceHolder addresses, separate from transaction Settler targets.
ZERO_EX_ALLOWED_ALLOWANCE_TARGETS=
# Comma-separated 4-byte selectors, for example 0x12345678,0x90abcdef.
# Populate from the current official 0x AllowanceHolder/Settler ABI.
ZERO_EX_ALLOWED_SELECTORS=
ZERO_EX_QUOTE_TTL_SECONDS=90
SOURCE_CHAIN_ID=11155111
DESTINATION_CHAIN_ID=421614
DESTINATION_STC_TOKEN=

# Dedicated chain-worker authentication and leasing.
# Development fallback. Production must use workerId:secret pairs below.
LISTENER_HMAC_SECRET=replace-with-a-separate-random-secret
LISTENER_HMAC_KEYS=ccip-worker-1:replace-with-a-unique-worker-secret
LISTENER_SIGNATURE_WINDOW_SECONDS=300
RELAYER_LEASE_SECONDS=300

# Optional production services
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=agentmarket
S3_SECRET_KEY=replace-me
S3_BUCKET=deliveries

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=false

# Local dynamic V1 uses fixed independent RPCs. The scripts validate these IDs
# at startup and refuse an occupied port that serves a different chain.
LOCAL_CHAIN_A_ID=31337
LOCAL_CHAIN_A_RPC_URL=http://127.0.0.1:8545
LOCAL_CHAIN_B_ID=31338
LOCAL_CHAIN_B_RPC_URL=http://127.0.0.1:8546
LOCAL_CHAIN_C_ID=31339
LOCAL_CHAIN_C_RPC_URL=http://127.0.0.1:8547
LOCAL_CHAIN_D_ID=31340
LOCAL_CHAIN_D_RPC_URL=http://127.0.0.1:8548

# Controlled multi-chain experiment V2. Besu defaults use 9545-9548; the
# functional Hardhat fallback launcher uses 8645-8648.
EXPERIMENT_V2_CHAIN_A_RPC=http://127.0.0.1:9545
EXPERIMENT_V2_CHAIN_B_RPC=http://127.0.0.1:9546
EXPERIMENT_V2_CHAIN_C_RPC=http://127.0.0.1:9547
EXPERIMENT_V2_CHAIN_D_RPC=http://127.0.0.1:9548
EXPERIMENT_V2_MANIFEST=.runtime/experiment-v2/deployment.json
EXPERIMENT_V2_RELAY_DB=data/experiment-v2-relay.db
EXPERIMENT_V2_CONFIRMATIONS=2
EXPERIMENT_V2_RELAY_PRIVATE_KEY=
EXPERIMENT_V2_RELAY_POLL_MS=1000
EXPERIMENT_V2_RELAY_DELAY_MS=0
EXPERIMENT_V2_REORG_DEPTH=12
EXPERIMENT_V2_BLOCK_CHUNK_SIZE=500
EXPERIMENT_V2_RELAY_MAX_ATTEMPTS=8
EXPERIMENT_V2_RELAY_RETRY_MS=1000
EXPERIMENT_V2_FAIL_TARGET_CHAIN=
EXPERIMENT_V2_REVERSE_PENDING=0
EXPERIMENT_V2_CRASH_AFTER_ENQUEUE=0

# Agent Runner and optional DeepSeek provider. The Runner refuses invoke calls
# without a token unless AGENT_RUNNER_ALLOW_INSECURE_LOCAL=true is set explicitly.
LLM_PROVIDER=mock
LLM_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_MAX_TOKENS=4096
# Optional independent Kimi Runner. The local experiment starts it on port 8121
# only when KIMI_API_KEY is present (or LOCAL_ENABLE_KIMI_RUNNER=true).
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_TIMEOUT_SECONDS=300
KIMI_MAX_RETRIES=2
KIMI_MAX_TOKENS=4096
LOCAL_ENABLE_KIMI_RUNNER=false
LOCAL_RUNNER_KIMI_PORT=8121
# Runner-owned persistent conversation storage and read-only Markdown knowledge.
AGENT_CHAT_DB_PATH=
AGENT_CHAT_MAX_TURNS=12
# Semicolon-separated files or directories. Empty defaults to the project docs folder.
AGENT_KNOWLEDGE_PATHS=
AGENT_RUNNER_API_TOKEN=replace-with-a-dedicated-agent-runner-token
AGENT_RUNNER_ALLOW_INSECURE_LOCAL=false
AGENT_RUNNER_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AGENT_PLATFORM_TIMEOUT_SECONDS=10
# Optional persistent heartbeat registrations, keyed by Agent slug. The onboarding
# page can register the same values at runtime for the current process.
AGENT_PLATFORM_REGISTRATIONS_JSON=
DEV_IDENTITY_SEED=replace-with-a-stable-local-development-seed
DEV_DID_PREFIX=did:local
# Production JSON map: {"agent-slug":"32-byte-secp256k1-private-key-hex"}
AGENT_RUNTIME_PRIVATE_KEYS_JSON=
# Agent Runner only. Map Agent slug to its home-chain EVM private key. Never
# inject this variable into the API, Protocol Worker, web app, or repository.
# The Worker refuses to start when this variable is present.
AGENT_HOME_WALLET_PRIVATE_KEYS_JSON=
# Agent Runner only. Each policy binds an Agent to chainId, homeWallet, RPC,
# approved contract artifacts/methods, and transaction value/Gas limits.
AGENT_WALLET_POLICIES_JSON=
# Required in production so wallet-signing request nonces survive Runner restarts.
AGENT_WALLET_NONCE_STORE_PATH=
AGENT_RUNNER_BASE_URL=http://127.0.0.1:8010
# Optional per-Agent Runner endpoints. Local experiment mode starts B/C/D on
# separate processes and supplies this map automatically.
AGENT_RUNNER_ENDPOINTS_JSON=
AGENT_RUNNER_SLUGS=
AGENT_RUNNER_ID=
LOCAL_AGENT_RUNNER_PORT=8010
AGENT_HEARTBEAT_TTL_SECONDS=60
AGENT_INVOCATION_TIMEOUT_SECONDS=2100
# External Agent V2 is negotiated per manifest. V1 remains a migration fallback.
AGENT_PROTOCOL_VERSION=2.0
# Execution Agent keys remain in the existing Runner until a Sidecar shadow
# comparison succeeds. This setting never applies to the Requester Client.
SIGNER_MODE=RUNNER
SIGNER_SIDECAR_URL=
SIGNER_SIDECAR_TOKEN=
AGENT_TASK_DEADLINE_SECONDS=2400
PROTOCOL_JOB_STALE_SECONDS=3600
WORKFLOW_COORDINATE_IDEMPOTENCY_LIMIT=64
HEARTBEAT_CHALLENGE_RETENTION_SECONDS=3600
AGENT_MIN_GAS_BALANCE_WEI=1
REQUIRE_SIGNED_AGENT_RESULTS=true
AUTO_INVOKE_AGENTS=true
AGENT_RUNTIME_TOKENS_JSON=

# User-facing Coordinator Agent. It holds no user or provider wallet key.
COORDINATOR_PLATFORM_URL=http://127.0.0.1:8000
COORDINATOR_REQUESTER_DID=did:local:campus-requester
COORDINATOR_API_TOKEN=replace-with-a-dedicated-coordinator-token
COORDINATOR_ALLOW_INSECURE_LOCAL=false
COORDINATOR_LLM_PROVIDER=mock
COORDINATOR_STATE_PATH=
COORDINATOR_PLATFORM_REGISTRATION_PATH=
COORDINATOR_AGENT_KEY=workflow-coordinator-agent
COORDINATOR_AGENT_DID=did:local:workflow-coordinator-agent
# Required in production. Development derives a stable key from DEV_IDENTITY_SEED.
COORDINATOR_AGENT_PRIVATE_KEY=
LOCAL_COORDINATOR_PORT=8300

# Real CCIP deployment, optional until testnet funds are available.
# Use a fresh test wallet. Never reuse a private key exposed in screenshots,
# chat logs, commits, or documentation.
SOURCE_RPC_URL=
DESTINATION_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Public-testnet step 8 only; none of these values are used by local V1.
# Default intended route: Ethereum Sepolia -> Arbitrum Sepolia.
# Fill these from Chainlink CCIP Explorer/Directory on the deployment day.
SOURCE_CCIP_ROUTER=
DESTINATION_CCIP_ROUTER=
SOURCE_CHAIN_SELECTOR=
DESTINATION_CHAIN_SELECTOR=
SOURCE_SETTLEMENT_TOKEN=
DESTINATION_SETTLEMENT_TOKEN=

# Filled after deployment.
REAL_CCIP_RECEIVER_ADDRESS=
REAL_CCIP_SENDER_ADDRESS=
REAL_MARKETPLACE_ESCROW_ADDRESS=

# Required for real Escrow deployment and sender authorization.
REAL_PLATFORM_SIGNER=
AUTHORIZED_ESCROW=
MOCK_CCIP_SENDER_FOR_ESCROW=
CCIP_GAS_LIMIT=300000

# Independent listener/relayer worker. Keep RELAYER_PRIVATE_KEY out of API
# process environments and use a fresh low-balance testnet account.
CHAIN_WORKER_ID=ccip-worker-1
# Must equal this worker's value in LISTENER_HMAC_KEYS. Prefer injecting this
# only into the Worker container instead of exposing the full key map there.
CHAIN_WORKER_HMAC_SECRET=replace-with-a-unique-worker-secret
RELAYER_PRIVATE_KEY=
CHAIN_WORKER_DB=./data/chain-worker.db
SOURCE_CONFIRMATIONS=3
DESTINATION_CONFIRMATIONS=5
CHAIN_REORG_DEPTH=12
CHAIN_BLOCK_CHUNK_SIZE=1000
CHAIN_POLL_INTERVAL_MS=5000
SOURCE_START_BLOCK=0
DESTINATION_START_BLOCK=0
RELAYER_MAX_ATTEMPTS=8
RELAYER_HEARTBEAT_MS=30000
RELAYER_RECEIPT_TIMEOUT_MS=120000
RELAYER_DROPPED_AFTER_MS=600000
RELAYER_SIGNER_MODE=env
# The chain worker always uses API leases. SHADOW may be used while validating
# a second Worker without granting it broadcast authority.
WORKER_MODE=LEASED
CHAIN_EVENT_MAX_ATTEMPTS=8
CHAIN_EVENT_RETRY_BASE_MS=1000
CHAIN_WORKER_HEALTH_PORT=9090
CHAIN_ALERT_WEBHOOK_URL=
CCIP_STALLED_AFTER_SECONDS=3600

# Wallet-owned CLI inputs. A_PRIVATE_KEY/B_PRIVATE_KEY belong only in the
# invoking shell, never in the API or chain-worker environment.
API_URL=http://127.0.0.1:8000
AGENT_API_TOKEN=
A_PRIVATE_KEY=
B_PRIVATE_KEY=
MAX_SLIPPAGE_BPS=100
PAYOUT_SELL_AMOUNT=

# Destination test liquidity. The script derives sqrtPriceX96 from the human
# STC-per-USDC price and token ordering. POOL_SQRT_PRICE_X96 is an optional override.
UNISWAP_V3_POSITION_MANAGER=
STC_INITIAL_SUPPLY=1000000000000000000000000
POOL_USDC_AMOUNT=
POOL_STC_AMOUNT=
POOL_STC_PER_USDC=10
POOL_SQRT_PRICE_X96=
POOL_LIQUIDITY_SLIPPAGE_BPS=100
POOL_FEE=3000
POOL_TICK_LOWER=-887220
POOL_TICK_UPPER=887220
USDC_STC_POOL_ADDRESS=
PAYOUT_TAKER_ADDRESS=
PAYOUT_TEST_SELL_AMOUNT=100000

# First real CCIP settlement send, optional until real testnet deployment is
# complete. Amount is in the source token's smallest unit.
SETTLEMENT_ID=0x1111111111111111111111111111111111111111111111111111111111111111
ORDER_ID=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
PAYEE_ADDRESS=
SETTLEMENT_AMOUNT=100000
CCIP_EXPLORER_URL=https://ccip.chain.link/
ALLOW_DIRECT_CCIP_TEST=false

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-market.local/schemas/settlement-intent.json",
  "title": "Settlement intent",
  "type": "object",
  "required": [
    "intentId",
    "orderId",
    "payerAccount",
    "payeeAccount",
    "assetId",
    "amount",
    "status"
  ],
  "properties": {
    "intentId": { "type": "string", "format": "uuid" },
    "orderId": { "type": "string", "format": "uuid" },
    "payerAccount": { "type": "string", "pattern": "^[a-z0-9-]+:[^:]+:.+$" },
    "payeeAccount": { "type": "string", "pattern": "^[a-z0-9-]+:[^:]+:.+$" },
    "assetId": { "type": "string", "pattern": "^[a-z0-9-]+:[^/]+/.+$" },
    "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
    "sourceChain": { "type": ["string", "null"] },
    "destinationChain": { "type": ["string", "null"] },
    "status": {
      "enum": [
        "created",
        "lock_pending",
        "locked",
        "release_pending",
        "released",
        "refund_pending",
        "refunded",
        "failed"
      ]
    },
    "transactionHashes": { "type": "array", "items": { "type": "string" } },
    "ccipMessageId": { "type": ["string", "null"] },
    "confirmations": { "type": "integer", "minimum": 0 },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
